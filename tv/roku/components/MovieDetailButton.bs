import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/rfTheme.bs"

sub init()
    m.top.iconSide = "left"
    m.buttonBackground = m.top.findNode("buttonBackground")
    m.buttonIcon = m.top.findNode("buttonIcon")
    m.buttonText = m.top.findNode("buttonText")
end sub

sub itemContentChanged()
    itemData = m.top.itemContent

    ' ReelForge: rounded buttons like the web app (white when focused, a dark glass chip otherwise)
    m.buttonText.font = rfFont("textSemi", itemData.fontSize - 3)
    m.buttonBackground.uri = "pkg:/images/rf/rf-round.9.png"
    m.buttonIcon.uri = itemData.icon
    ' A colored icon means "on" (in My List, watched, favorite): shown in ember
    m.iconOn = isIconColored(itemData.iconBlendColor)
    m.buttonText.text = itemData.text
    m.buttonBackground.height = itemData.height
    m.buttonBackground.width = itemData.width

    m.focusTextColor = rfColor.BASE
    m.textColor = rfColor.TEXT
    m.focusBackground = "#FFFFFF"
    m.focusIcon = itemData.focusIcon
    m.icon = itemData.icon
    m.background = rfColor.SURFACE2
    m.height = itemData.height
    m.width = itemData.width
    m.padding = itemData.padding
    m.iconSide = itemData.iconSide

    setIconSize()

    m.buttonText.height = m.height

    m.top.focus = itemData.focus
    onFocusChanged()
end sub


' Color fields read back as integers (0xRRGGBBAA); white or unset means "off"
function isIconColored(c as dynamic) as boolean
    if c = invalid then return false
    if isString(c)
        v = LCase(c)
        return v <> "" and v <> "#ffffff" and v <> "#ffffffff" and v <> "0xffffffff"
    end if
    return c <> 0 and c <> -1 and c <> &hFFFFFFFF
end function

sub onFocusChanged()
    if m.top.focus
        m.buttonText.color = m.focusTextColor
        m.buttonIcon.uri = m.focusIcon <> "" ? m.focusIcon : m.icon
        m.buttonIcon.blendColor = m.iconOn ? "#C25E00" : rfColor.BASE
        m.buttonBackground.blendColor = m.focusBackground
        m.buttonBackground.opacity = 1
    else
        m.buttonText.color = m.textColor
        m.buttonIcon.uri = m.icon
        m.buttonIcon.blendColor = m.iconOn ? rfColor.EMBER : rfColor.TEXT
        m.buttonBackground.blendColor = m.background
        m.buttonBackground.opacity = 0.7
    end if
end sub

sub setIconSize()
    height = m.buttonBackground.height
    width = m.buttonBackground.width
    if height > 0 and width > 0
        ' TODO: Use smallest number between them
        m.buttonIcon.height = m.height

        if m.padding > 0
            m.buttonIcon.height = m.buttonIcon.height - m.padding
        end if

        m.buttonIcon.width = m.buttonIcon.height

        ' Set Icon translation
        if LCase(m.iconSide) = "right"
            m.buttonIcon.translation = [m.buttonBackground.width - m.padding - m.buttonIcon.width, ((height - m.buttonIcon.height) / 2)]
            m.buttonText.translation = [m.padding, 0]
        else
            m.buttonIcon.translation = [m.padding, ((height - m.buttonIcon.height) / 2)]
            m.buttonText.translation = [m.padding + m.buttonIcon.width + 20, 0]
        end if

        ' Set text max width
        m.buttonText.maxWidth = m.width - m.padding - m.buttonIcon.width - 40
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "right" and m.top.focus
        m.top.escape = "right"
    end if

    if key = "left" and m.top.focus
        m.top.escape = "left"
    end if

    return false
end function
