import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/Image.bs"
import "pkg:/source/enums/AnimationControl.bs"
import "pkg:/source/enums/AnimationState.bs"
import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/misc.bs"
import "pkg:/source/utils/rfTheme.bs"

sub init()
    m.isFirstRun = true
    m.top.overhangTitle = ""
    m.top.optionsAvailable = false
    m.postTask = createObject("roSGNode", "PostTask")

    m.favoritesOptionText = tr("Add To Favorites")

    m.loadItemsTask1 = createObject("roSGNode", "LoadItemsTask")
    m.loadItemsTask1.observeField("content", "onMyListLoaded")
    m.loadItemsTask1.itemsToLoad = "isInMyList"

    m.loadMetaDataTask = CreateObject("roSGNode", "LoadItemsTask")
    m.loadMetaDataTask.itemsToLoad = "metaData"
    m.loadMetaDataTask.observeField("content", "onMetaDataLoaded")

    m.homeRows = m.top.findNode("homeRows")
    m.homeRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)

    ' ReelForge: billboard, top bar, and who has focus ("hero", "rows" or "top")
    m.hero = m.top.findNode("hero")
    m.heroFocus = m.top.findNode("heroFocus")
    m.topBar = m.top.findNode("topBar")
    m.topBar.observeField("selected", "onTopBarSelected")
    m.topBar.observeField("leaveDown", "onTopBarDown")
    m.homeRows.focusBitmapBlendColor = rfColor.EMBER
    m.homeRows.observeField("featured", "onFeatured")
    m.homeRows.observeField("rowItemFocused", "onRowItemFocused")
    m.homeRows.observeField("focusedChild", "onRowsFocus")
    m.featured = []
    m.featuredIndex = 0
    m.heroButton = 0
    m.rotateTimer = m.top.findNode("rotateTimer")
    m.rotateTimer.observeField("fire", "onRotate")
    m.deviceInfo = CreateObject("roDeviceInfo")
    m.state = "rows"
end sub

' ---------------------------------------------------------------- ReelForge billboard

' The billboard's titles arrived: show the first and give it focus if nothing else has it yet.
sub onFeatured()
    m.featured = m.homeRows.featured
    if not isValid(m.featured) then m.featured = []
    m.featuredIndex = 0
    m.hero.dotCount = m.featured.count()
    if m.featured.count() = 0
        if m.state = "hero" then focusRows()
        return
    end if
    ' Home opens on the billboard; later refreshes leave focus where the viewer put it
    ' (but never pull focus away from somewhere the viewer already moved to while it loaded)
    if m.topBar.isInFocusChain()
        m.heroShown = true
    else if m.homeRows.isInFocusChain() and (m.heroShown = true or m.userMoved = true)
        m.heroShown = true
        showRowItem()
    else
        m.heroShown = true
        focusHero()
    end if
    m.rotateTimer.control = "start"
end sub

sub showFeatured()
    if m.featured.count() = 0 then return
    if m.featuredIndex >= m.featured.count() then m.featuredIndex = 0
    m.hero.item = heroItemFor(m.featured[m.featuredIndex], true)
    m.hero.dotIndex = m.featuredIndex
end sub

' Every 9 seconds on the billboard with nobody touching the remote: next title.
sub onRotate()
    if m.state <> "hero" or m.featured.count() < 2 then return
    if not m.heroFocus.hasFocus() then return
    if m.deviceInfo.TimeSinceLastKeypress() < 9 then return
    m.featuredIndex = (m.featuredIndex + 1) mod m.featured.count()
    showFeatured()
end sub

' While the rows have focus, the billboard describes the highlighted card.
sub onRowItemFocused()
    if m.state = "rows"
        f = m.homeRows.rowItemFocused
        if isValid(f) and f.count() = 2 and (f[0] > 0 or f[1] > 0) then m.userMoved = true
        showRowItem()
    end if
end sub

sub onRowsFocus()
    if m.homeRows.isInFocusChain()
        m.state = "rows"
        m.homeRows.drawFocusFeedback = true
        m.hero.showButtons = false
        m.hero.buttonFocus = -1
        showRowItem()
    end if
end sub

sub showRowItem()
    item = focusedRowItem()
    if isValid(item) then m.hero.item = heroItemFor(item, false)
end sub

function focusedRowItem() as dynamic
    focus = m.homeRows.rowItemFocused
    content = m.homeRows.content
    if not isValid(content) then return invalid
    if not isValidAndNotEmpty(focus) or focus.count() < 2 or focus[0] < 0 then focus = [0, 0]
    row = content.getChild(focus[0])
    if not isValid(row) then return invalid
    return row.getChild(focus[1])
end function

' What the billboard shows for a HomeData node.
function heroItemFor(node as object, featured as boolean) as object
    json = node.json
    if not isValid(json) then json = {}
    itemType = LCase(chainLookupReturn(node, "type", ""))
    title = node.LookupCI("name") ?? ""
    subtitle = ""
    if itemType = "episode"
        if isValidAndNotEmpty(json.SeriesName) then title = json.SeriesName
        code = ""
        if isValid(json.ParentIndexNumber) and isValid(json.IndexNumber) then code = `S${json.ParentIndexNumber}:E${json.IndexNumber}`
        subtitle = rfJoin([code, json.name])
    end if

    rating = ""
    if isValid(json.CommunityRating) and json.CommunityRating > 0
        tenths = int(json.CommunityRating * 10 + 0.5)
        rating = `★ ${int(tenths / 10)}.${tenths mod 10}`
    end if
    genres = ""
    if featured and isValidAndNotEmpty(json.Genres)
        g = []
        for each name in json.Genres
            if g.count() < 2 then g.push(name)
        end for
        genres = g.Join(", ")
    end if
    meta = rfJoin([subtitle, json.ProductionYear, json.OfficialRating, rfRuntime(json.RunTimeTicks), rating, genres])

    backdrop = ""
    logo = ""
    if itemType = "collectionfolder" or itemType = "userview"
        backdrop = node.LookupCI("widePosterUrl") ?? ""
    else
        backdrop = ItemImageURL(json, ImageType.BACKDROP, { "maxWidth": 1920, "quality": 85 })
        if backdrop = "" then backdrop = ItemImageURL(json, ImageType.THUMB, { "maxWidth": 1920, "quality": 85 })
        logo = ItemImageURL(json, ImageType.LOGO, { "maxWidth": 640 })
    end if
    return { title: title, meta: meta, overview: json.Overview ?? "", backdropUrl: backdrop, logoUrl: logo }
end function

sub focusHero()
    if m.featured.count() = 0
        focusRows()
        return
    end if
    m.state = "hero"
    m.homeRows.drawFocusFeedback = false
    m.heroFocus.setFocus(true)
    setLastFocus(m.heroFocus)
    m.hero.showButtons = true
    m.hero.buttonFocus = m.heroButton
    showFeatured()
end sub

sub focusRows()
    m.state = "rows"
    m.homeRows.drawFocusFeedback = true
    m.hero.buttonFocus = -1
    m.hero.showButtons = false
    m.homeRows.setFocus(true)
    setLastFocus(m.homeRows)
    showRowItem()
end sub

sub focusTopBar()
    m.state = "top"
    m.homeRows.drawFocusFeedback = false
    m.hero.buttonFocus = -1
    m.topBar.callFunc("enter")
    setLastFocus(m.topBar)
end sub

sub onTopBarDown()
    if m.featured.count() > 0 then focusHero() else focusRows()
end sub

' Billboard buttons: Play starts the title, More Info opens it.
sub activateHeroButton()
    node = m.featured[m.featuredIndex]
    if not isValid(node) then return
    if m.heroButton = 0
        m.top.quickPlayNode = node
    else
        m.top.selectedItem = node
    end if
end sub

' ---------------------------------------------------------------- ReelForge top bar

sub onTopBarSelected()
    choice = m.topBar.selected
    if choice = "home"
        onTopBarDown()
    else if choice = "search"
        m.top.getScene().jumpTo = { selectionType: "search" }
    else if choice = "settings"
        m.top.getScene().jumpTo = { selectionType: "settings" }
    else if choice = "movies"
        openLibrary("movies")
    else if choice = "tv"
        openLibrary("tvshows")
    else if choice = "mylist"
        jumpToRow(tr("My List"))
    end if
end sub

' Movies / TV Shows: open that library (with several, go to the row of libraries to pick one).
sub openLibrary(collectionType as string)
    matches = []
    libraries = m.homeRows.libraries
    if isValid(libraries)
        for each lib in libraries
            if isStringEqual(lib.LookupCI("collectionType"), collectionType) then matches.push(lib)
        end for
    end if
    if matches.count() = 1
        m.top.selectedItem = matches[0]
    else
        jumpToRow(tr("My Media"))
    end if
end sub

sub jumpToRow(title as string)
    content = m.homeRows.content
    if not isValid(content) then return
    for i = 0 to content.getChildCount() - 1
        if isStringEqual(content.getChild(i).title, title)
            focusRows()
            m.homeRows.jumpToRowItem = [i, 0]
            return
        end if
    end for
    focusRows()
end sub

sub refresh()
    m.homeRows.focusBitmapBlendColor = rfColor.EMBER
    m.homeRows.callFunc("updateHomeRows")
end sub



sub loadLibraries()
    m.homeRows.callFunc("loadLibraries")
end sub

' JFScreen hook called when the screen is displayed by the screen manager
sub OnScreenShown()
    ' ReelForge: Home draws its own top bar, so the standard overhang stays hidden here
    scene = m.top.getScene()
    overhang = scene.findNode("overhang")
    if isValid(overhang)
        overhang.visible = false
        overhang.isVisible = false
    end if
    m.topBar.userName = chainLookupReturn(m.global.session, "user.name", "")

    last = m.top.lastFocus
    if isValid(last) and last.isSameNode(m.topBar)
        focusTopBar()
    else if isValid(last) and last.isSameNode(m.homeRows)
        focusRows()
    else if m.featured.count() > 0
        focusHero()
    else
        m.top.setFocus(true)
        focusRows()
    end if

    if not m.isFirstRun
        if m.homeRows.callFunc("isFocusOnFavoriteRow")
            m.homeRows.focusBitmapBlendColor = chainLookupReturn(m.global.session, "user.settings.colorCursor", ColorPalette.HIGHLIGHT)
            m.homeRows.callFunc("reloadFavorites")
        else
            refresh()
        end if
    end if

    ' post the device profile the first time this screen is loaded
    if m.isFirstRun
        m.isFirstRun = false
        m.postTask.arrayData = getDeviceCapabilities()
        m.postTask.apiUrl = "/Sessions/Capabilities/Full"
        m.postTask.control = "RUN"
        m.postTask.observeField("responseCode", "postFinished")
    end if
end sub

' JFScreen hook called when the screen is hidden by the screen manager
sub OnScreenHidden()
    ' Other screens use the standard overhang again
    scene = m.top.getScene()
    overhang = scene.findNode("overhang")
    if isValid(overhang)
        overhang.visible = true
        overhang.isVisible = true
        overhang.callFunc("dehighlightUser")
        overhang.currentUser = ""
        overhang.title = ""
    end if
end sub

' Triggered by m.postTask after completing a post.
' Empty the task data when finished.
sub postFinished()
    m.postTask.unobserveField("responseCode")
    m.postTask.callFunc("empty")
end sub





sub onMyListLoaded()
    isInMyListData = m.loadItemsTask1.content
    m.loadItemsTask1.content = []

    if not isValidAndNotEmpty(isInMyListData) then return

    focusedItem = m.homeRows.content.getChild(m.homeRows.rowItemFocused[0]).getChild(m.homeRows.rowItemFocused[1])
    if not isValid(focusedItem) then return

    dialogData = []
    paramData = {
        id: focusedItem.LookupCI("id")
    }

    if isInMyListData[0]
        dialogData.push(tr("Remove From My List"))
    else
        if inArray([ItemType.EPISODE, ItemType.MOVIE, ItemType.SEASON, ItemType.SERIES, ItemType.VIDEO, ItemType.MUSICVIDEO, ItemType.RECORDING, ItemType.BOXSET], focusedItem.LookupCI("type"))
            dialogData.push(tr("Add To My List"))
        end if
    end if

    if not inArray([ItemType.RADIOSTATION], focusedItem.LookupCI("type"))
        dialogData.push(m.favoritesOptionText)
    end if

    if not inArray([ItemType.COLLECTIONFOLDER, ItemType.RADIOSTATION, ItemType.CHANNEL, ItemType.FOLDER, ItemType.PLAYLIST, ItemType.PROGRAM, ItemType.TVCHANNEL, ItemType.USERVIEW], focusedItem.LookupCI("type"))
        dialogData.push(tr("Add To Playlist"))
    end if

    if inArray([ItemType.EPISODE, ItemType.MOVIE, ItemType.SEASON, ItemType.SERIES, ItemType.VIDEO, ItemType.MUSICVIDEO, ItemType.RECORDING, ItemType.BOXSET, ItemType.AUDIOBOOK, ItemType.BOOK], focusedItem.LookupCI("type"))
        showBothOptions = false
        if isChainValid(focusedItem, "PlayedPercentage")
            if focusedItem.PlayedPercentage > 0
                showBothOptions = true
            end if
        end if

        if showBothOptions
            dialogData.push(tr("Mark As Unplayed"))
            dialogData.push(tr("Mark As Played"))
        else
            if isChainValid(focusedItem, "isWatched")
                if focusedItem.isWatched
                    dialogData.push(tr("Mark As Unplayed"))
                else
                    dialogData.push(tr("Mark As Played"))
                end if
            end if
        end if
    end if

    if inArray([ItemType.EPISODE, ItemType.SEASON], focusedItem.LookupCI("type"))
        dialogData.push(tr("Go To Series"))
        dialogData.push(tr("Go To Season"))
        paramData.SeasonId = focusedItem.json.LookupCI("SeasonId")
        paramData.SeriesId = focusedItem.json.LookupCI("SeriesId")
    end if

    if inArray([ItemType.MUSICALBUM], focusedItem.LookupCI("type"))
        dialogData.push(tr("Play Instant Mix"))
        dialogData.push(tr("Go To Artist"))

        genreData = focusedItem.json.LookupCI("Genre")
        if isValidAndNotEmpty(genreData)
            if isValidAndNotEmpty(genreData[0])
                if isValidAndNotEmpty(genreData[0].Name)
                    dialogData.push(tr("Go To Genre") + `: ${genreData[0].LookupCI("Name")}`)
                    paramData.GenreName = genreData[0].LookupCI("Name")
                    paramData.GenreId = genreData[0].LookupCI("Id")
                    paramData.LibraryId = chainLookup(focusedItem, "json.LibraryId")
                end if
            end if
        end if

        paramData.ArtistId = focusedItem.json.LookupCI("AlbumArtistId")
        paramData.ArtistName = focusedItem.json.LookupCI("albumartist")
        paramData.AlbumId = focusedItem.LookupCI("id")
    end if

    m.global.sceneManager.callFunc("optionDialog", "libraryitem", focusedItem.LookupCI("title") ?? tr("Options"), [], dialogData, paramData)
end sub

sub setLastFocus(lastFocusElement)
    group = m.global.sceneManager.callFunc("getActiveScene")

    if isValid(group)
        group.lastFocus = lastFocusElement
    end if
end sub

function audioMiniPlayerIsVisibleInScene()
    scene = m.top.getScene()
    audioMiniPlayer = scene.findNode("audioMiniPlayer")

    if not isValid(audioMiniPlayer) then return false

    return audioMiniPlayer.callFunc("isVisible")
end function

' Special handling for key presses on the home screen.
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    m.userMoved = true

    ' ReelForge: billboard buttons
    if m.state = "hero" and m.heroFocus.hasFocus()
        if isStringEqual(key, KeyCode.LEFT) or isStringEqual(key, KeyCode.RIGHT)
            m.heroButton = 1 - m.heroButton
            m.hero.buttonFocus = m.heroButton
            return true
        end if
        if isStringEqual(key, KeyCode.OK)
            activateHeroButton()
            return true
        end if
        if isStringEqual(key, KeyCode.DOWN)
            focusRows()
            return true
        end if
        if isStringEqual(key, KeyCode.UP)
            focusTopBar()
            return true
        end if
        if isStringEqual(key, KeyCode.PLAY)
            m.heroButton = 0
            activateHeroButton()
            return true
        end if
        return false
    end if

    ' If the user hit back and is not on the first item of the row,
    ' assume they want to go to the first item of the row.
    ' Otherwise, they are exiting the app.
    if isStringEqual(key, KeyCode.BACK)
        rowItemFocused = chainLookupReturn(m.homeRows, "rowItemFocused", [0, 0])
        if isNumber(rowItemFocused[1])
            if rowItemFocused[1] > 0
                m.homeRows.jumpToRowItem = [rowItemFocused[0], 0]
                return true
            end if
            if m.homeRows.isInFocusChain() and m.featured.count() > 0
                m.homeRows.jumpToRowItem = [0, 0]
                focusHero()
                return true
            end if
        end if
    end if

    if isStringEqual(key, KeyCode.OPTIONS)
        if m.homeRows.hasFocus()
            focusedItem = m.homeRows.content.getChild(m.homeRows.rowItemFocused[0]).getChild(m.homeRows.rowItemFocused[1])
            if not isValidAndNotEmpty(focusedItem) then return false
            if chainLookupReturn(focusedItem, "json.FavoriteViewAll", false) then return true

            ' Skip loading playlists and mylist data for radio stations
            if inArray([ItemType.RADIOSTATION], focusedItem.LookupCI("type"))
                itemID = focusedItem.LookupCI("id")
                if isStringEqual(itemID, "createstation")
                    return false
                end if

                paramData = {
                    id: itemID
                }
                m.global.sceneManager.callFunc("optionDialog", "libraryitem", focusedItem.LookupCI("title") ?? tr("Options"), [], [tr("Delete Radio Station")], paramData)
                return true
            end if


            m.loadMetaDataTask.itemId = focusedItem.LookupCI("id")
            m.loadMetaDataTask.control = TaskControl.RUN
            return true
        end if
    end if

    if isStringEqual(key, KeyCode.UP)
        if m.featured.count() > 0 then focusHero() else focusTopBar()
        return true
    end if

    return false
end function

sub onMetaDataLoaded()
    data = m.loadMetaDataTask.content[0]

    m.favoritesOptionText = chainLookupReturn(data, "json.UserData.IsFavorite", false) ? tr("Remove From Favorites") : tr("Add To Favorites")

    focusedItem = m.homeRows.content.getChild(m.homeRows.rowItemFocused[0]).getChild(m.homeRows.rowItemFocused[1])

    m.loadItemsTask1.itemId = focusedItem.LookupCI("id")
    m.loadItemsTask1.control = TaskControl.RUN
end sub
