<?xml version="1.0" encoding="utf-8"?>
<component name="HomeItem" extends="Group">
  <children>
    <!-- ReelForge card: picture with the title on it (dark fade at the bottom), progress underneath -->
    <Rectangle id="backdrop" width="420" height="236" />
    <Poster id="itemIcon" width="90" height="90" translation="[165,60]" loadDisplayMode="scaleToFit" />
    <Poster id="itemPoster" width="420" height="236" loadDisplayMode="scaleToZoom">
      <Poster id="shade" uri="pkg:/images/rf/rf-card-shade.png" width="420" height="140" translation="[0, 96]" loadDisplayMode="scaleToFill" />
      <PlayedCheckmark id="playedIndicator" translation="[340, 0]" />
    </Poster>

    <Rectangle id="progressBackground" visible="false" width="420" height="6" translation="[0, 246]" color="#3A4654">
      <Rectangle id="progress" width="0" height="6" />
    </Rectangle>

    <ScrollingText id="itemText" horizAlign="left" vertAlign="bottom" height="36" maxWidth="384" translation="[18, 160]" repeatCount="0" />
    <ScrollingText id="itemTextExtra" horizAlign="left" vertAlign="center" height="26" maxWidth="384" translation="[18, 198]" visible="false" repeatCount="0" />

    <Animation id="showProgressBar" duration="0.5" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="showProgressBarField" key="[0.0, 1.0]" fieldToInterp="progress.width" />
    </Animation>
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="focusChanged" />
  </interface>
</component>