<?xml version="1.0" encoding="utf-8"?>
<!-- ReelForge Home: full-screen billboard, top bar, and rows of 16:9 cards (like the web app). -->
<component name="Home" extends="JFScreen">
  <children>
    <RFHero id="hero" />
    <HomeRows
      id="homeRows"
      showRowLabel="true"
      vertFocusAnimationStyle="fixedFocus"
      rowFocusAnimationStyle="fixedFocusWrap"
      itemComponentName="HomeItem"
      numRows="3" />
    <RFTopBar id="topBar" active="home" />
    <!-- takes key focus while the billboard buttons are active (keys bubble up to Home) -->
    <Group id="heroFocus" focusable="true" />
    <OptionsSlider id="options" />
    <Timer id="rotateTimer" duration="9" repeat="true" />
  </children>
  <interface>
    <field id="playlistData" type="array" />
    <field id="selectedItem" alias="homeRows.selectedItem" />
    <field id="rowFocused" alias="homeRows.itemFocused" />
    <field id="quickPlayNode" alias="homeRows.quickPlayNode" />
    <function name="refresh" />
    <function name="loadLibraries" />
  </interface>
</component>
