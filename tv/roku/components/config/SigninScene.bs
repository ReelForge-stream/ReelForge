import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/PosterLoadStatus.bs"
import "pkg:/source/enums/String.bs"
import "pkg:/source/utils/misc.bs"

const blankUserAvatarUri = "pkg:/images/baseline_person_white_48dp.png"

sub onProfileImageUriChange()
    if not isValid(m.top.profileImageUri)
        m.top.profileImageUri = blankUserAvatarUri
    end if

    if isStringEqual(m.top.profileImageUri, string.EMPTY)
        m.top.profileImageUri = blankUserAvatarUri
    end if

    m.profileImage.uri = m.top.profileImageUri
end sub

sub onPosterLoadStatusChanged()
    if m.profileImage.loadStatus <> PosterLoadStatus.LOADING
        m.profileImage.unobserveField("loadStatus")
    end if

    if isStringEqual(m.profileImage.loadStatus, PosterLoadStatus.FAILED)
        m.top.profileImageUri = blankUserAvatarUri
    end if
end sub

sub init()
    m.top.setFocus(true)
    m.top.optionsAvailable = false

    m.profileImage = m.top.findNode("overlayCurrentUserProfileImage")
    m.profileImage.observeField("loadStatus", "onPosterLoadStatusChanged")

    m.submit = m.top.findNode("submit")
    m.submit.background = "#2B3846"
    m.submit.color = ColorPalette.WHITE
    m.submit.focusBackground = ColorPalette.HIGHLIGHT
    m.submit.focusColor = "#17202A"

    m.quickConnect = m.top.findNode("quickConnect")
    m.quickConnect.background = "#2B3846"
    m.quickConnect.color = ColorPalette.WHITE
    m.quickConnect.focusBackground = ColorPalette.HIGHLIGHT
    m.quickConnect.focusColor = "#17202A"
    ' "New QR code" asks the server for a fresh code (the old one stops working)
    m.quickConnect.observeField("selected", "onNewQrCode")

    initQrSignIn()

    m.errorContainer = m.top.findNode("errorContainer")
    m.errorContainer.color = "#CC0000"

    m.config = m.top.findNode("configOptions")
    m.config.focusBitmapBlendColor = ColorPalette.HIGHLIGHT
    m.config.focusFootprintBlendColor = ColorPalette.TRANSPARENT
    ' When the last form field is confirmed, jump focus straight to Submit
    m.config.observeField("allFieldsSubmitted", "onAllFieldsSubmitted")

    username_field = CreateObject("roSGNode", "ConfigData")
    username_field.label = tr("Username")
    username_field.type = "string"
    username_field.value = string.EMPTY

    password_field = CreateObject("roSGNode", "ConfigData")
    password_field.label = tr("Password")
    password_field.type = "password"
    registryPassword = get_setting("password")
    if isValid(registryPassword)
        password_field.value = registryPassword
    end if

    saveCredentials = m.top.findNode("saveCredentials")
    saveCredentials.focusedColor = ColorPalette.HIGHLIGHT
    saveCredentials.font.size = 30
    saveCredentials.focusedFont.size = 30

    if not isStringEqual(get_setting("saveCredentials", "true"), "true")
        saveCredentials.checkedState = "[false]"
    end if

    items = [username_field, password_field]
    m.config.configItems = items

    saveCredentials.checkedIconUri = "pkg:/images/icons/checkboxChecked.png"
    saveCredentials.focusedCheckedIconUri = "pkg:/images/icons/checkboxChecked.png"

    saveCredentials.uncheckedIconUri = "pkg:/images/icons/checkboxUnchecked.png"
    saveCredentials.focusedUncheckedIconUri = "pkg:/images/icons/checkboxUnchecked.png"
end sub

sub onAlertChange()
    m.errorContainer.visible = isValidAndNotEmpty(m.top.alert)

    errorMessage = m.top.findNode("errorMessage")
    errorMessage.text = m.top.alert

    ' A failed password sign-in: bring phone sign-in back with a fresh code
    if isValidAndNotEmpty(m.top.alert) and isValid(m.qrActive) and m.qrActive and m.qrSecret = ""
        requestQrCode()
    end if
end sub

sub onUserChange()
    username_field = m.config.content.getChild(0)

    if isStringEqual(m.top.user, string.EMPTY) and isValid(get_setting("username"))
        username_field.value = get_setting("username")
    else
        username_field.value = m.top.user
    end if

    ' Username has been provided, focus on password field
    if not isStringEqual(username_field.value, string.EMPTY)
        m.config.jumpToItem = 1
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    ' Returns true if user navigates to a new focusable element
    if not press then return false

    list = m.top.findNode("configOptions")
    saveCredentials = m.top.findNode("saveCredentials")

    if key = KeyCode.BACK
        m.top.backPressed = true
        return false
    end if

    if key = KeyCode.DOWN and list.isInFocusChain()
        limit = list.content.getChildren(-1, 0).count() - 1

        if limit = list.itemFocused
            saveCredentials.setFocus(true)
            group = m.global.sceneManager.callFunc("getActiveScene")
            group.lastFocus = saveCredentials
            return true
        end if
        return false
    end if

    if key = KeyCode.DOWN and saveCredentials.isInFocusChain()
        m.submit.setFocus(true)
        m.submit.focus = true

        group = m.global.sceneManager.callFunc("getActiveScene")
        group.lastFocus = m.submit
        return true
    end if

    if key = KeyCode.UP and m.submit.hasFocus()
        m.submit.focus = false

        saveCredentials.setFocus(true)
        group = m.global.sceneManager.callFunc("getActiveScene")
        group.lastFocus = saveCredentials
        return true
    end if

    if key = KeyCode.UP and m.quickConnect.hasFocus()
        m.quickConnect.focus = false

        saveCredentials.setFocus(true)
        group = m.global.sceneManager.callFunc("getActiveScene")
        group.lastFocus = saveCredentials
        return true
    end if

    if key = KeyCode.UP and saveCredentials.isInFocusChain()
        list.setFocus(true)
        group = m.global.sceneManager.callFunc("getActiveScene")
        group.lastFocus = list
        return true
    end if

    if key = KeyCode.RIGHT and m.submit.hasFocus()
        m.submit.focus = false

        m.quickConnect.setFocus(true)
        m.quickConnect.focus = true

        group = m.global.sceneManager.callFunc("getActiveScene")
        group.lastFocus = m.quickConnect
        return true
    end if

    if key = KeyCode.LEFT and m.quickConnect.hasFocus()
        m.quickConnect.focus = false

        m.submit.setFocus(true)
        m.submit.focus = true

        group = m.global.sceneManager.callFunc("getActiveScene")
        group.lastFocus = m.submit
        return true
    end if

    if key = KeyCode.OK
        if m.quickConnect.hasFocus()
            m.quickConnect.selected = not m.quickConnect.selected
            return true
        end if
        if m.submit.hasFocus()
            m.submit.selected = not m.submit.selected
            return true
        end if
    end if

    return false
end function

' Fired when FormList confirms the last field (Password).
' Jumps focus directly to Submit, skipping the "Save Credentials" checkbox
' -- UX decision: the user can still toggle it manually before submitting.
sub onAllFieldsSubmitted()
    m.submit.setFocus(true)
    m.submit.focus = true

    group = m.global.sceneManager.callFunc("getActiveScene")
    group.lastFocus = m.submit
end sub

' ---------------------------------------------------------------- ReelForge: QR sign-in
'
' On open the screen asks the server for a Quick Connect code and shows it as a QR code (a link to
' <server>/reelforge/link?code=…) plus the digits. Every 3 seconds it asks whether someone approved it
' on their phone; when they have, qrAuthenticated fires and ShowScenes finishes signing in.
' Codes expire on the server after a few minutes, so a fresh one is fetched every 9 minutes.

sub initQrSignIn()
    m.qrPanel = m.top.findNode("qrPanel")
    m.qrImage = m.top.findNode("qrImage")
    m.qrLoading = m.top.findNode("qrLoading")
    m.qrCode = m.top.findNode("qrCode")
    m.qrHelp = m.top.findNode("qrHelp")
    m.qrPollTimer = m.top.findNode("quickConnectTimer")
    m.qrPollTimer.observeField("fire", "onQrPoll")
    m.qrRefreshTimer = m.top.findNode("qrRefreshTimer")
    m.qrRefreshTimer.observeField("fire", "onNewQrCode")
    m.qrImage.observeField("loadStatus", "onQrImageStatus")
    ' A password sign-in stops phone sign-in, so the two can't both log in at once
    m.submit.observeField("selected", "onPasswordSubmit")
    m.qrSecret = ""
    m.qrActive = false ' true only while this screen is showing (OnScreenShown starts the first code)
end sub

sub requestQrCode()
    if not m.qrActive then return
    m.qrPollTimer.control = "stop"
    m.qrSecret = ""
    m.qrImage.uri = ""
    m.qrLoading.text = tr("Getting a code…")
    m.qrLoading.visible = true
    m.qrCode.text = ""
    m.qrHelp.text = ""

    ' Only the newest request counts: forget any earlier one still on its way
    if isValid(m.qrInitTask)
        m.qrInitTask.unobserveField("result")
        m.qrInitTask.control = "STOP"
    end if
    m.qrInitTask = CreateObject("roSGNode", "QrSignInTask")
    m.qrInitTask.observeField("result", "onQrCode")
    m.qrInitTask.control = "RUN"
end sub

sub onQrCode(event as object)
    task = event.getRoSGNode()
    if not isValid(m.qrInitTask) or not task.isSameNode(m.qrInitTask) then return
    task.unobserveField("result")
    if not m.qrActive then return

    result = event.getData()
    failed = not isValid(result) or not isValid(result.Code) or not isValid(result.Secret)
    if not failed and isValid(result.error) then failed = (result.error = true)
    if failed
        m.qrLoading.text = tr("Phone sign-in is turned off on this server.")
        m.qrHelp.text = tr("Use your password instead, or turn on Quick Connect in the server's settings.")
        return
    end if

    code = result.Code
    m.qrSecret = result.Secret
    server = rfServerUrl()
    m.qrImage.uri = `${server}/ReelForge/QuickConnect/Qr?code=${code}&size=400`
    m.qrCode.text = rfSpacedCode(code)
    m.qrHelp.text = tr("Scan with your phone's camera, then tap Sign in. Or open") + ` ${rfShortHost(server)}/reelforge/link ` + tr("and enter the code.")

    m.qrPollTimer.control = "start"
    m.qrRefreshTimer.control = "start"
end sub

' An older server without the ReelForge QR image: the digits still work in Quick Connect.
sub onQrImageStatus()
    status = m.qrImage.loadStatus
    if status = "ready"
        m.qrLoading.visible = false
    else if status = "failed"
        m.qrLoading.text = tr("Enter the code below in Quick Connect on your phone or computer.")
        m.qrLoading.visible = true
    end if
end sub

sub onQrPoll()
    if not m.qrActive or m.qrSecret = "" then return
    if isValid(m.qrCheckTask) and m.qrCheckTask.state = "run" then return
    if isValid(m.qrCheckTask) then m.qrCheckTask.unobserveField("authenticated")
    m.qrCheckTask = CreateObject("roSGNode", "QuickConnect")
    m.qrCheckTask.secret = m.qrSecret
    m.qrCheckTask.saveCredentials = m.top.findNode("saveCredentials").checkedState[0]
    m.qrCheckTask.observeField("authenticated", "onQrChecked")
    m.qrCheckTask.control = "RUN"
end sub

sub onQrChecked(event as object)
    task = event.getRoSGNode()
    if not isValid(m.qrCheckTask) or not task.isSameNode(m.qrCheckTask) then return
    if not m.qrActive then return
    if task.authenticated > 0
        stopQrSignIn()
        ' Close the on-screen keyboard if it was open over the password form
        scene = m.top.getScene()
        if isValid(scene) and isValid(scene.dialog) then scene.dialog.close = true
        m.top.qrAuthenticated = true
    end if
end sub

sub onNewQrCode()
    requestQrCode()
end sub

sub onPasswordSubmit()
    stopQrSignIn()
end sub

' Stops everything phone sign-in is doing; OnScreenShown starts a fresh code if the screen comes back.
sub stopQrSignIn()
    if isValid(m.qrPollTimer) then m.qrPollTimer.control = "stop"
    if isValid(m.qrRefreshTimer) then m.qrRefreshTimer.control = "stop"
    if isValid(m.qrInitTask)
        m.qrInitTask.unobserveField("result")
        m.qrInitTask.control = "STOP"
    end if
    if isValid(m.qrCheckTask)
        m.qrCheckTask.unobserveField("authenticated")
        m.qrCheckTask.control = "STOP"
    end if
    m.qrSecret = ""
end sub

' Stop asking the server once this screen goes away (signed in, Back, or another screen on top).
sub OnScreenHidden()
    m.qrActive = false
    stopQrSignIn()
end sub

' Showing the screen (first time or coming back) starts phone sign-in with a fresh code.
sub OnScreenShown()
    group = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(m.top.lastFocus)
        m.top.lastFocus.setFocus(true)
        if isValid(group) then group.lastFocus = m.top.lastFocus
    else
        m.top.setFocus(true)
        if isValid(group) then group.lastFocus = m.top
    end if

    m.qrActive = true
    if isValid(m.qrPollTimer) and m.qrSecret = "" and not (isValid(m.qrInitTask) and m.qrInitTask.state = "run")
        requestQrCode()
    end if
end sub

function rfServerUrl() as string
    url = chainLookupReturn(m.global.session, "server.url", "")
    if not isString(url) then return ""
    while url.Right(1) = "/"
        url = url.Left(url.Len() - 1)
    end while
    return url
end function

' "http://192.168.1.10:8096" -> "192.168.1.10:8096"
function rfShortHost(url as string) as string
    i = url.Instr("://")
    if i >= 0 then return url.Mid(i + 3)
    return url
end function

' "429251" -> "429 251"
function rfSpacedCode(code as string) as string
    if code.Len() = 6 then return `${code.Left(3)} ${code.Right(3)}`
    return code
end function
